# Static website: enforce HTTPS and disable directory listings.
Options -Indexes
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://hesseldevries.com%{REQUEST_URI} [R=301,L]

# Block server scripts, configuration files and editor/archive backups.
<FilesMatch "(?i)(\.(php[0-9]*|phtml|phar)(\.|$)|\.(old|bk|bak|sql|sqlite|zip|tar|gz)$|~[0-9]*(\.[^.]+)?$|^\.env(\.|$)|^\.git)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=604800"
</IfModule>
